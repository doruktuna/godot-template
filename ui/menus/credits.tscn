[node name="RichTextLabel" type="RichTextLabel" parent="Content" unique_id=1852219860]
layout_mode = 2
bbcode_enabled = true
text = "[center][b][color=DODGER_BLUE][font_size=96][u]2D Project Template[/u][/font_size][/color][/b][/center]


[p align=c]Created by [b][color=orange]Doruk Tuna[/color][/b][/p]

[p align=c]For learning and as a starting template[/p]

[p align=c]You can use any kind of control nodes, its basically scrolled by changing the position of the Content node[/p]

[p align=c]This part uses a [color=red]RichTextLabel[/color][/p]

[p align=c]Which allows for some fancy animations
[pulse freq=1.0 color=#ff5599 ease=-3.0]Pulsing Colors[/pulse]

[wave amp=50.0 freq=2.0 connected=1]Waving Text[/wave]

[tornado radius=10.0 freq=1.0 connected=1]Tornado Effect[/tornado]

[shake rate=20.0 level=5 connected=1]Shaking Text[/shake]

[rainbow freq=0.4 sat=0.8 val=0.8 speed=1.0]Rainbow Colors[/rainbow]
[/p]

[p align=c]Check BBCode for many markup options[/p]
"
fit_content = true
scroll_active = false

